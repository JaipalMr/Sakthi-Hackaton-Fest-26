# ---- Backend (copy to .env in the repo root; NEVER commit .env) ----
# LLM provider: "anthropic", "openai" (any OpenAI-compatible API incl. Ollama/Groq/LM Studio) or "none".
# With "none" (or no key) the assistant and briefing run in clearly-labelled DEMO mode.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# For LLM_PROVIDER=openai (set LLM_MODEL to e.g. gpt-4o-mini, or llama3.1 for Ollama):
OPENAI_API_KEY=
OPENAI_BASE_URL=            # e.g. http://localhost:11434/v1 for Ollama; empty = https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=25
LLM_MAX_TOOL_ROUNDS=4

# CORS: comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Operational assumptions (NOT universal safety thresholds - tune with your operator's own policy)
OPS_LOAD_ELEVATED=0.90
OPS_LOAD_HIGH=1.15
OPS_CROWD_ELEVATED=0.50
OPS_CROWD_HIGH=0.80
OPS_RESERVE_MARGIN=0.10
OPS_DISPATCH_BUFFER_MIN=5
OPS_MIN_BUSES_PER_STOP=1
OPS_MAX_MOVES=20

# ---- Frontend: put this in frontend/.env.local ----
# VITE_API_BASE_URL=http://127.0.0.1:8000
